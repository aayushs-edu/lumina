  "narrative": {
    "northStar": "The Reading Room After the Aurora",
    "overview": "The home page opens on the animated Aurora: soft pools of peach, coral, amber and rose light on a cream-to-white ground, with the lowercase wordmark set huge. Below it, that warm light settles into flat fields of colour. Brand orange is a solid block, warm white is the reading ground, and deep ink closes the page with cream text. Nothing below the hero glows, floats or slides on its own. The page is a reading room, not a dashboard: stories are excerpts divided by hairlines, the atlas sits in a single square frame, and emphasis comes from weight and size in one typeface.\n\nThe density is calm and editorial. Sections use generous vertical padding (112-120px wide, 64-72px narrow) and one horizontal gutter that steps with width. Every corner is square: buttons, tags, the nav links bar, the atlas frame, the tooltip and the country dialog. Depth is tonal. Only layers that genuinely float above the page (the atlas tooltip, the hero's primary call to action) cast a shadow, and that shadow has a real downward offset.\n\nThe subject is people's lived harm, so the system stays warm and serious. Colour carries warmth; it is never used to decorate data or to make the page feel playful.",
    "keyCharacteristics": [
      "Flat colour fields below the hero: orange block, warm-white reading ground, ink closing band.",
      "Baloo 2 is the only typeface; hierarchy comes from weight (400-800) and size.",
      "Square corners everywhere (0px).",
      "1px warm hairlines (rule) separate content instead of cards.",
      "The Aurora hero is the only animated, gradient-lit surface."
    ],
    "rules": [
      {
        "name": "The Flat Field Rule",
        "body": "Below the hero, colour arrives as solid blocks (orange, paper, ink). No gradients, no glows, no tinted overlays.",
        "section": "colors"
      },
      {
        "name": "The Readable Orange Rule",
        "body": "Lumina Orange is a field or fill, or it sits on ink. On paper or white, orange text uses Burnt Orange Text.",
        "section": "colors"
      },
      {
        "name": "The Raised Is White Rule",
        "body": "The ground is Warm Paper; anything floating above it (nav bar, tooltip, dialog) is Pure White with a Hairline Rose border.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Baloo 2 is the only typeface. Emphasis comes from weight and size, never from a second family.",
        "section": "typography"
      },
      {
        "name": "The Solid Ink Heading Rule",
        "body": "Headings are solid colour: ink on light grounds, cream on ink, with \"lumina\" picked out in orange. The hero wordmark's shimmer belongs to that wordmark alone.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Sections, story entries, buttons below the hero, tags and frames have no shadow. A shadow means the element floats above the page.",
        "section": "elevation"
      },
      {
        "name": "The Square Corner Rule",
        "body": "No border radius anywhere on the home page. Any new component starts at 0px.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** set colour as flat fields: orange (#FF6600) blocks, Warm Paper (#FFFCFA) reading grounds, Ember Ink (#2A1A16) bands with cream (#FFF1E6) text.",
      "**Do** use Burnt Orange Text (#B84A00) for any orange text on paper or white.",
      "**Do** separate content with 1px Hairline Rose (#EADBD2) rules instead of cards.",
      "**Do** keep every corner at 0px, including dialogs, tooltips and tags.",
      "**Do** give every interactive element a hover state and a 2px square keyboard focus treatment, as the square buttons, story entries and nav links have.",
      "**Do** step the gutter 20 / 40 / 64px at 600 / 1100px, and cap content at 1200px."
    ],
    "donts": [
      "**Don't** add a border radius anywhere on the home page.",
      "**Don't** use gradient or glowing text outside the hero wordmark.",
      "**Don't** use a typeface other than Baloo 2.",
      "**Don't** put shadows on resting surfaces. A shadow is only for a floating layer and always has a downward offset.",
      "**Don't** use the hotspot data colours for UI, brand or decoration.",
      "**Don't** reuse the Aurora's light, ribbons or shimmer outside the hero."
    ]
  }
}